title    Hasenheide
about    Balearic for the hill at sunset. Nylon guitar, marimba, a flute that's in no hurry.
at       cafe
tempo    104
beats    4
steps    4
swing    0.08
reverb   0.4

voice flute   flute    vol=0.85 pan=-0.2
voice gtr     guitar   vol=0.7  pan=0.3 gate=0.5 center=G4
voice marimba marimba  vol=0.6  pan=-0.35
voice pad     strings  vol=0.35 center=E4
voice bass    fretless vol=0.85
voice kick    kick     vol=0.55
voice conga   conga    vol=0.45 pan=-0.3
voice shaker  shaker   vol=0.35 pan=0.4

pattern intro
pad | [Fmaj7]?--------------- | [Em7]?--------------- |
gtr | .- [Fmaj7]- .- [Fmaj7]- .- [Fmaj7]- .- [Fmaj7]- | .- [Em7]- .- [Em7]- .- [Em7]- .- [Em7]- |

pattern A
gtr     | .- [Fmaj7]- .- [Fmaj7]- .- [Fmaj7]- .- [Fmaj7]- | .- [Em7]- .- [Em7]- .- [Em7]- .- [Em7]- | .- [Dm7]- .- [Dm7]- .- [Dm7]- .- [Dm7]- | .- [Em7]- .- [Em7]- .- [Em7]- .- [Em7]- |
marimba | C5- A4- F4- A4- C5- A4- F4- E4- | B4- G4- E4- G4- B4- G4- E4- D4- | A4- F4- D4- F4- A4- F4- D4- C4- | B4- G4- E4- G4- D5- B4- G4- E4- |
pad     | [Fmaj7]?--------------- | [Em7]?--------------- | [Dm7]?--------------- | [Em7]?--------------- |
bass    | F2--- . F2 C3- F2--- ~E2--- | E2--- . E2 B2- E2--- ~D2--- | D2--- . D2 A2- D2--- ~E2--- | E2--- . E2 B2- E2--- ~F2--- |
kick    | x... .... x... .... | % | % | % |
conga   | ..x. .o.x ..x. .o.. | % | % | % |
shaker  | o.x. o.xo o.x. o.xo | % | % | % |

pattern A2 from A
flute | A5------- G5--- E5--- | G5------- E5--- D5--- | F5--------------- | E5--------------- |

play intro
loop A A2 A2 A
