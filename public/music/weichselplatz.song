title    Weichselplatz
about    Vietnamese bolero pop for the restaurants. A zither ostinato in a lilting 3-3-2, a sliding đàn bầu tune on five notes, a bamboo flute an octave up for the chorus.
tempo    100
beats    4
steps    4
reverb   0.35

# The tune keeps to the pentatonic G A C D E; the zither carries Am7, Dm7, G6, Cmaj7, two bars each.
voice bau    triangle vol=0.65 pan=-0.1 glide=0.14
voice sao    flute    vol=0.55 pan=0.15 oct=1
voice tranh  qanun    vol=0.6  pan=0.25
voice guitar guitar   vol=0.3  pan=-0.3 center=C4 gate=0.5
voice bass   upright  vol=0.85
voice kick   kick     vol=0.6
voice rim    rim      vol=0.35 pan=-0.2
voice shake  shaker   vol=0.25 pan=0.3

pattern base
tranh  | A3-- E4-- G4- C5-- G4-- E4- | A3-- E4-- G4- C5-- D5-- E4- | D3-- A3-- C4- F4-- C4-- A3- | D3-- A3-- C4- F4-- E4-- C4- |
tranh  | G3-- D4-- E4- B4-- E4-- D4- | G3-- D4-- E4- B4-- D5-- B4- | C3-- G3-- B3- E4-- B3-- G3- | C3-- G3-- B3- E4-- G4-- E4- |
guitar | .... [Am7]- .. .... [Am7]- .. | % | .... [Dm7]- .. .... [Dm7]- .. | % | .... [G6]- .. .... [G6]- .. | % | .... [Cmaj7]- .. .... [Cmaj7]- .. | % |
bass   | A1------- E2------- | A1----- . A1 E2------- | D2------- A1------- | D2----- . D2 A1------- |
bass   | G1------- D2------- | G1----- . G1 D2------- | C2------- G1------- | C2----- . C2 G1------- |
kick   | x... .... x... .... | % | % | % | % | % | % | % |
rim    | .... x... .... x..x | % | % | % | % | % | % | .... x... .... x.xx |
shake  | x.xx x.xx x.xx x.xx | % | % | % | % | % | % | % |

# Zither and bass alone; the tune picks up on the last bar.
pattern intro from base
mute guitar kick rim shake
bau    | _ | _ | _ | _ |
bau    | _ | _ | _ | ........ .. A4- C5- D5- |

pattern A from base
bau    | E5--- D5- C5- D5- D5- D5- C5- | A4--- .. C5 D5 .. .. A4- C5- | D5- D5- D5- C5- D5- E5- D5- C5- | A4--- C5----- .. A4- C5- |
bau    | D5- D5- D5- E5- D5--- C5- A4- | C5 D5 .. G4--- .... A4- C5- | E5--- D5- C5- D5- E5- G5- E5- | D5 E5 ~C5------- ...... |

pattern A2 from A
bau    | E5--- D5- C5- D5- D5- D5- C5- | A4--- .. C5 D5 .. .. A4- C5- | D5- D5- D5- C5- D5- E5- D5- C5- | A4--- C5----- .. A4- C5- |
bau    | D5- D5- D5- E5- G5--- E5- D5- | E5 G5 .. E5--- .... D5- E5- | G5--- E5- D5- C5- D5- E5- D5- | C5 A4 ~C5------- ...... |

# Up the octave on the bamboo flute.
pattern B from base
sao    | E5------- D5- C5- D5- E5- | E5 G5 .. E5- D5- C5--- .. A4- | D5------- C5- D5- E5- D5- | D5 E5 .. C5- A4- C5--- .... |
sao    | G5------- E5- D5- E5- G5- | A5 G5 .. E5- D5- E5--- .. D5- | E5--- D5- C5- A4--- C5- D5- | C5----------- .... |

pattern B2 from B
sao    | E5------- D5- C5- D5- E5- | E5 G5 .. E5- D5- C5--- .. A4- | D5------- C5- D5- E5- D5- | D5 E5 .. C5- A4- C5--- .... |
sao    | G5------- E5- D5- E5- G5- | A5 G5 .. E5- D5- E5--- .. D5- | E5--- D5- C5- A4--- C5- D5- | C5------- .. A4- C5- D5- |

# The zither plays the tune on its own.
pattern D
tranh  | E5--- D5- C5- D5- D5- D5- C5- | A4--- .. C5 D5 .. .. A4- C5- | D5- D5- D5- C5- D5- E5- D5- C5- | A4--- C5----- .. A4- C5- |
tranh  | D5- D5- D5- E5- D5--- C5- A4- | C5 D5 .. G4--- .... A4- C5- | E5--- D5- C5- D5- E5- G5- E5- | D5 E5 C5------- ...... |

loop intro A A2 B B2 A2 D
