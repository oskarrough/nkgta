title    Tempelhofer Feld
about    The whole sky at once, over the old runways. Strings and a choir, horns when the kites go up, timpani like engines a long way off.
at       feld
tempo    64
beats    4
steps    2
reverb   0.8

# D major, one bar is four slow beats. Everything rings into everything else.
voice str   strings  vol=0.5  center=D4 att=0.7 rel=1.6
voice low   strings  vol=0.45 att=0.6 rel=1.6
voice choir choir    vol=0.45 center=A4 att=0.9 rel=2
voice horn  horn     vol=0.6  pan=-0.25 att=0.12 rel=0.8
voice harp  harp     vol=0.35 pan=0.35
voice timp  timpani  vol=0.65
voice crash crash    vol=0.22

# the field opens up: strings and the choir, nothing moving yet
pattern intro
str   | [D]------- | [G]------- | [D]------- | [A]------- |
low   | D2------- | G1------- | D2------- | A1------- |
choir | [D]?------- | [G]?------- | [D]?------- | [A]?------- |

pattern A
str  | [D]------- | [A]------- | [Bm]------- | [G]------- | [D]------- | [A]------- | [G]------- | [A]------- |
low  | D2------- | A1------- | B1------- | G1------- | D2------- | A1------- | G1------- | A1------- |
horn | F#4--- A4--- | E4------- | D4--- F#4- B4- | A4------- | F#4--- A4- D5- | C#5--- B4- A4- | B4--- G4- B4- | A4------- |
harp | D4 F#4 A4 D5 F#5 D5 A4 F#4 | A3 C#4 E4 A4 C#5 A4 E4 C#4 | B3 D4 F#4 B4 D5 B4 F#4 D4 | G3 B3 D4 G4 B4 G4 D4 B3 | D4 F#4 A4 D5 F#5 D5 A4 F#4 | A3 C#4 E4 A4 C#5 A4 E4 C#4 | G3 B3 D4 G4 B4 G4 D4 B3 | A3 C#4 E4 A4 C#5 A4 E4 C#4 |
timp | D2- ...... | A1- ...... | B1- ...... | G1- ...... | D2- ...... | A1- ...... | G1- ...... | A1- A1? A1? A1 A1 A1! . |
crash| x....... | ........ | ........ | ........ | ........ | ........ | ........ | ........ |

# the choir takes the tune up high, the horns answer underneath
pattern B from A
choir | A4--- D5--- | C#5------- | D5--- F#5--- | E5------- | F#5--- E5- D5- | E5--- C#5- A4- | B4--- D5- G5- | E5------- |
horn  | D4------- | C#4------- | B3------- | B3------- | A3------- | A3------- | G3------- | A3------- |
crash | X....... | ........ | ........ | ........ | ........ | ........ | ........ | x....... |

# a wide quiet, just the harp and the choir breathing
pattern C
str   | [Bm]?------- | [G]?------- | [D]?------- | [A]?------- |
choir | [Bm]?------- | [G]?------- | [D]?------- | [A]?------- |
harp  | B3 D4 F#4 B4 D5 B4 F#4 D4 | G3 B3 D4 G4 B4 G4 D4 B3 | D4 F#4 A4 D5 F#5 D5 A4 F#4 | A3 C#4 E4 A4 C#5 A4 E4 C#4 |
low   | B1------- | G1------- | D2------- | A1------- |

play intro
loop A B C B
