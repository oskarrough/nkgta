title    Wriezener Bahnhof
about    Berghain at six on a Sunday morning, heard through a wall. Four to the floor, a rumble and a stab that keeps coming back.
tempo    134
beats    4
steps    4
reverb   0.45

voice stab  saw      vol=0.4  pan=0.2 gate=0.6 center=F4 rev=0.6
voice pad   pad      vol=0.3  center=F4
voice rumb  synbass  vol=1.0
voice kick  kick     vol=1.0
voice rim   rim      vol=0.35 pan=-0.3
voice hat   hat      vol=0.3  pan=0.3
voice ohat  ohat     vol=0.35 pan=-0.15

pattern intro
hat  | .x.x .x.x .x.x .x.x | % |
ohat | ..x. ..x. ..x. ..x. | % |

pattern A
kick | x... x... x... x... | % | % | % |
rumb | . F1 F1 . . F1 F1 . . F1 F1 . . F1 F1 . | % | % | . F1 F1 . . F1 F1 . . Eb1 Eb1 . . Eb1 Eb1 . |
hat  | .x.x .x.x .x.x .x.x | % | % | % |
ohat | ..x. ..x. ..x. ..x. | % | % | % |
rim  | .... ...x .... ..x. | % | % | % |

pattern B from A
stab | . . . [Fm7]? . . . . . . [Fm7]? . . . . . | % | % | . . . [Ebsus2]? . . . . . . [Ebsus2]? . . . . . |
pad  | [Fm]?--------------- | = | [Dbmaj7]?--------------- | [Eb]?--------------- |

play intro
loop A A B B B A
