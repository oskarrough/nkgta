title    Pannierstraße
about    Chattery repeated-note pop over a 3-3-2 keyboard stab. Am7, Cmaj7 over B, F over A, Dm over A; the chorus jumps an octave onto the glockenspiel.
tempo    120
beats    4
steps    4
reverb   0.25

voice lead  chip     vol=0.5  pan=-0.1 gate=0.85
voice glock glock    vol=0.6  pan=0.15 oct=1
voice keys  organ    vol=0.4  pan=0.2 gate=0.6
voice bass  synbass  vol=0.8  gate=0.8
voice kick  kick     vol=0.75
voice rim   rim      vol=0.4  pan=-0.2
voice hat   hat      vol=0.3  pan=0.25

# The left hand under every chorus: two bars each of Am7, Cmaj7/B, F/A, Dm/A.
pattern base
keys  | A3+C4+E4+G4--- .. A3+C4+E4+G4- A3+C4+E4+G4- A3+C4+E4+G4- .. A3+C4+E4+G4- | .. A3+C4+E4+G4- .. A3+C4+E4+G4- A3+C4+E4+G4- A3+C4+E4+G4- .... | B3+C4+E4+G4--- .. B3+C4+E4+G4- B3+C4+E4+G4- B3+C4+E4+G4- .. B3+C4+E4+G4- | .. B3+C4+E4+G4- .. B3+C4+E4+G4- B3+C4+E4+G4- B3+C4+E4+G4- .... |
keys  | A3+C4+E4+F4--- .. A3+C4+E4+F4- A3+C4+E4+F4- A3+C4+E4+F4- .. A3+C4+E4+F4- | .. A3+C4+E4+F4- .. A3+C4+E4+F4- A3+C4+E4+F4- A3+C4+E4+F4- .... | A3+C4+D4+F4--- .. A3+C4+D4+F4- A3+C4+D4+F4- A3+C4+D4+F4- .. A3+C4+D4+F4- | .. A3+C4+D4+F4- .. A3+C4+D4+F4- A3+C4+D4+F4- A3+C4+D4+F4- .... |
bass  | A1--- .. A1- A1- A1- .. A1- | .. A1- .. A1- A1- A1- .... | C2--- .. C2- C2- C2- .. C2- | .. C2- .. C2- C2- C2- .... |
bass  | F1--- .. F1- F1- F1- .. F1- | .. F1- .. F1- F1- F1- .... | D2--- .. D2- D2- D2- .. D2- | .. D2- .. D2- D2- D2- .... |
kick  | x... .... x... .... | % | % | % | % | % | % | % |
rim   | .... x... .... x... | % | % | % | % | % | % | % |
hat   | ..x. ..x. ..x. ..x. | % | % | % | % | % | % | % |

# Seven bars of keys alone, then the tune picks up on the last.
pattern intro from base
mute kick rim hat
lead  | _ | _ | _ | _ |
lead  | _ | _ | _ | .. C5- C5- C5- C5- C5- C5- C5- |

pattern A from base
lead  | E5- E5- D5- C5- C5- C5- C5- C5- | E5- E5- D5- C5- C5 D5 .. .... | ........ E5- E5- D5- C5- | C5 D5 .. C5- C5- E5- E5- E5- E5- |
lead  | E5--- D5- C5- C5- E5- D5- C5- | C5 D5 .. C5- C5- E5- E5- E5- E5- | E5--- D5- .. C5- C5- C5- C5- | C5- E5- D5- C5- C5 D5 .. G4 A4 .. |

pattern B from base
lead  | .... G4 A4 .. .... G4 A4 .. | .... E5- E5- E5- E5- E5- F5- | G5--- F5- E5- E5- E5- D5- C5- | D5 E5 .. .. E5- E5- E5- E5- F5- |
lead  | G5--- F5--- E5- E5- D5- C5- | D5 E5 .. C5--- .... C5- C5- | E5- D5- C5- C5- C5- C5- C5- C5- | E5--- C5- C5- C5- C5- C5- C5- |

pattern C from base
lead  | A4--- C5- C5- E5 E5-- E5 F5-- | E5--- D5--- .. C5- C5- C5- | E5- E5- C5- C5- C5- C5- E5- .. | .. E5- E5- F5- E5--- D5--- |
lead  | .... C5- C5- E5- E5- C5- C5- | E5- E5- C5- C5- E5- E5- E5- F5- | E5--- D5----- C5- D5- .. | .... D5- .. E5- E5- E5- F5- |

pattern D from base
lead  | E5--- C5----- C5- C5- C5- | C5- E5- D5- C5- C5 D5 .. .... | .. C5- C5- C5- C5- E5- D5- C5- | C5 D5 .. .. C5- E5- E5- E5- F5- |
lead  | E5--- C5----- .. C5- C5- | C5- E5- D5- C5- C5 D5 .. C5- A4- | -- .. B4 C5 .. .. E5- D5- C5- | C5 D5 .. .... E5- E5- E5- F5- |

pattern E from base
lead  | E5--- C5----- C5- C5- C5- | C5- E5- D5- C5- C5 D5 .. .... | .. C5- C5- C5- C5- E5- D5- C5- | C5 D5 .. .. C5- E5- E5- E5- F5- |
lead  | E5--- C5----- .. C5- C5- | C5- E5- D5- C5- C5 D5 .. C5- A4- | -- .. B4 C5 .. .. A4- C5- A4- | C5--- ........ A4-- . |

# Up the octave.
pattern F from base
glock | .... E5- E5- E5- E5- .. A5 B5 | -- A5------- .. G5- .. | E5- .. E5- E5- E5- E5- .. A5 B5 | -- A5------- .. G5- .. |
glock | E5- .. E5- E5- E5- E5- .. A5 B5 | -- A5------- .. G5- .. | E5- .. E5- E5- E5- E5- .. A5 B5 | -- A5------- .. G5- .. |

pattern G from base
lead  | E5------- .. C5- E5- C5- | E5- C5- E5- C5- E5- C5- C5- C5- | E5- E5- D5- C5- .. C5- E5- C5- | E5- C5- E5- C5- E5- E5- E5- E5- |
lead  | G5- G5- C5--- .... E5-- . | .. C5- E5- C5- E5- C5- E5- C5- | E5--- E5- E5- G5- G5- G5- G5- | C5-- . .. C5- C5- C5- C5- C5- |

# The tune on its own.
pattern H
lead  | E5- E5- C5- C5- C5- C5- E5- E5- | .. C5- C5- C5- E5- E5- E5- F5- | E5--- D5- C5- E5- E5- C5- C5- | E5- E5- E5- F5- E5--- D5- C5- |
lead  | E5- E5- E5- E5- E5- F5- E5--- | D5- .. .. C5- E5- E5- C5- C5- | E5- E5- C5- C5- E5--- C5- C5- | E5- E5- E5- F5- E5--- D5-- . |

loop intro A B C D E F G H
